# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointment_db

# MCP Server
MCP_SERVER_NAME=appointment-mcp
MCP_SERVER_VERSION=1.0.0
MCP_HTTP_PORT=4020
MCP_MODE=http

# Optional admin protection
# ADMIN_TOKEN=replace-me

# 顾客身份模型（数字人接入）：
#   personal —— 默认。数字人账号即顾客本人账号（一人一数字人），X-Agent-Code 直接作为 customer_id
#   shared   —— 共享终端（如门店一楼公共数字人 hsh 依次接待多位顾客）。
#               顾客身份必须通过 identify_customer（手机号）建立会话绑定，
#               未识别时预约/查询/取消/改期一律返回 IDENTITY_REQUIRED，杜绝串号
IDENTITY_MODE=shared
# 顾客会话有效期（毫秒）。超时未操作自动解绑，需重新识别
CUSTOMER_SESSION_TTL_MS=1800000

# 知识库项目管理同步源（预约系统点击"同步信息"时调用）
# 本机直连知识库 API 时用 http://localhost:3001；Docker 内访问宿主机用 http://host.docker.internal:3001
KNOWLEDGE_BASE_URL=http://localhost:3001
KNOWLEDGE_BASE_ADMIN_TOKEN=dev-admin-token

# Timezone
TZ=Asia/Shanghai
